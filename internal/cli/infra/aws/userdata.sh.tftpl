#!/usr/bin/env bash
# MonVM <https://monvm.dev>
# Copyright The MonVM Authors
# SPDX-License-Identifier: Apache-2.0

set -euo pipefail
export DEBIAN_FRONTEND=noninteractive

curl --fail --silent --show-error --location \
  --connect-timeout 5 --max-time 120 --retry 10 --retry-delay 3 --retry-all-errors \
  --output /tmp/amazon-ssm-agent.deb \
  "https://s3.dualstack.${region}.amazonaws.com/amazon-ssm-${region}/latest/debian_${architecture}/amazon-ssm-agent.deb"
dpkg -i /tmp/amazon-ssm-agent.deb
rm -f /tmp/amazon-ssm-agent.deb
install -d -m 0755 /etc/amazon/ssm
cat >/etc/amazon/ssm/amazon-ssm-agent.json <<'JSON'
{
  "Agent": {
    "Region": "${region}",
    "UseDualStackEndpoint": true
  }
}
JSON
systemctl enable amazon-ssm-agent
systemctl restart amazon-ssm-agent

apt-get update
apt-get install -y --no-install-recommends awscli ca-certificates curl e2fsprogs nvme-cli openssl python3

download_object() {
  local object_key="$1" expected="$2"
  local archive="/tmp/$${object_key##*/}"
  aws s3 cp "s3://${bucket}/$object_key" "$archive" --region "${region}" \
    --endpoint-url "https://s3.dualstack.${region}.amazonaws.com" --only-show-errors
  printf '%s  %s\n' "$expected" "$archive" | sha256sum --check --status
  printf '%s\n' "$archive"
}

install_archive() {
  local object_key="$1" expected="$2" binary="$3" target="$4"
  local archive
  archive="$(download_object "$object_key" "$expected")"
  tar -xzf "$archive" -C /tmp "$binary"
  install -m 0755 "/tmp/$binary" "$target"
}

install_object() {
  local object_key="$1" expected="$2" target="$3"
  local object
  object="$(download_object "$object_key" "$expected")"
  install -m 0755 "$object" "$target"
}

install_daemon() {
  local name=$1 description=$2 user=$3 command=$4 after=$5 requires=$6 writable=$7 stop_signal=$8
  local require_line='' writable_line='' stop_line=''
  [[ -z "$requires" ]] || require_line="Requires=$requires"
  [[ -z "$writable" ]] || writable_line="ReadWritePaths=$writable"
  [[ -z "$stop_signal" ]] || stop_line="ExecStop=/bin/kill -s $stop_signal \$MAINPID"
  cat >"/etc/systemd/system/$name.service" <<UNIT
[Unit]
Description=$description
After=$after
Wants=network-online.target
$require_line

[Service]
User=$user
Group=$user
ExecStart=$command
$stop_line
Restart=on-failure
RestartSec=5s
LimitNOFILE=1048576
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
$writable_line

[Install]
WantedBy=multi-user.target
UNIT
}

install_oneshot() {
  local name=$1 description=$2 command=$3 after=$4 before=$5 requires=$6 remain=$7
  local before_line='' require_line='' remain_line=''
  [[ -z "$before" ]] || before_line="Before=$before"
  [[ -z "$requires" ]] || require_line="Requires=$requires"
  [[ "$remain" != true ]] || remain_line='RemainAfterExit=true'
  cat >"/etc/systemd/system/$name.service" <<UNIT
[Unit]
Description=$description
After=$after
Wants=network-online.target
$before_line
$require_line

[Service]
Type=oneshot
ExecStart=$command
$remain_line

[Install]
WantedBy=multi-user.target
UNIT
}

install_timer() {
  local name=$1 description=$2 interval=$3
  cat >"/etc/systemd/system/$name.timer" <<UNIT
[Unit]
Description=$description

[Timer]
OnUnitActiveSec=$interval
AccuracySec=30s
Persistent=true
Unit=$name.service

[Install]
WantedBy=timers.target
UNIT
}

device_for_volume() {
  local serial="$${1//-/}"
  local device
  for _ in $(seq 1 120); do
    for device in /dev/nvme*n1; do
      [[ -b "$device" ]] || continue
      if [[ "$(nvme id-ctrl -v "$device" 2>/dev/null | awk '/^sn[[:space:]]/ {gsub(/ /, "", $3); print $3; exit}')" == "$serial" ]]; then
        printf '%s\n' "$device"
        return 0
      fi
    done
    sleep 5
  done
  return 1
}

mount_volume() {
  local volume_id="$1" mountpoint="$2" expected_size="$3"
  local device uuid
  device="$(device_for_volume "$volume_id")"
  if ! blkid "$device" >/dev/null 2>&1; then
    mkfs.ext4 -F -O 64bit,huge_file,extent -T huge "$device"
  fi
  uuid="$(blkid -s UUID -o value "$device")"
  mkdir -p "$mountpoint"
  if ! grep -q "^UUID=$${uuid}[[:space:]]" /etc/fstab; then
    printf 'UUID=%s %s ext4 defaults,nofail 0 2\n' "$uuid" "$mountpoint" >> /etc/fstab
  fi
  mount "$mountpoint" || mount -a
  printf 'Ensuring %s uses the full %s GiB EBS volume\n' "$mountpoint" "$expected_size"
  resize2fs "$device"
}

%{ if metrics_enabled || logs_enabled ~}
useradd --system --home-dir /nonexistent --shell /usr/sbin/nologin envoy || true
install_object "${envoy_object_key}" "${envoy_sha256}" /usr/local/bin/envoy
install -d -m 0755 /etc/envoy /etc/monvm
printf '%s' '${trust_enroll}' | base64 -d >/usr/local/sbin/monvm-trust-enroll
printf '%s' '${trust_refresh}' | base64 -d >/usr/local/sbin/monvm-trust-refresh
chmod 0755 /usr/local/sbin/monvm-trust-enroll /usr/local/sbin/monvm-trust-refresh

cat >/usr/local/sbin/monvm-configure-service-network <<'SCRIPT'
#!/usr/bin/env bash
set -euo pipefail

mac=$1
ipv4=$2
ipv4_cidr=$3
ipv4_gateway=$4
ipv6=$5
ipv6_cidr=$6
table=$7
[[ "$ipv4" == - ]] && ipv4=
[[ "$ipv4_cidr" == - ]] && ipv4_cidr=
[[ "$ipv4_gateway" == - ]] && ipv4_gateway=
interface=
for _ in $(seq 1 300); do
  for path in /sys/class/net/*; do
    read -r candidate <"$path/address"
    if [[ "$candidate" == "$mac" ]]; then
      interface=$${path##*/}
      break 2
    fi
  done
  sleep 1
done
[[ -n "$interface" ]] || { echo "MonVM service ENI $mac did not appear" >&2; exit 1; }

ip link set "$interface" mtu 1500 up
ip -6 address replace "$ipv6/128" dev "$interface" nodad
ip -6 route replace table "$table" "$ipv6_cidr" dev "$interface" src "$ipv6"
ip -6 route replace table "$table" default via fe80:ec2::1 dev "$interface" src "$ipv6"
while ip -6 rule delete priority "$table" >/dev/null 2>&1; do :; done
ip -6 rule add priority "$table" from "$ipv6/128" table "$table"
if [[ -n "$ipv4" ]]; then
  prefix=$${ipv4_cidr#*/}
  ip address replace "$ipv4/$prefix" dev "$interface"
  ip route replace table "$table" "$ipv4_cidr" dev "$interface" src "$ipv4"
  ip route replace table "$table" default via "$ipv4_gateway" dev "$interface"
  while ip rule delete priority "$table" >/dev/null 2>&1; do :; done
  ip rule add priority "$table" from "$ipv4/32" table "$table"
  sysctl -q -w "net.ipv4.conf.$interface.rp_filter=2"
fi
SCRIPT
chmod 0755 /usr/local/sbin/monvm-configure-service-network

configure_service() {
  local service=$1 display=$2 ipv6=$3 public_ipv4=$4 private_ipv4=$5 mac=$6 table=$7 root=$8
  local trust="$root/envoy/trust"
  install -d -m 0755 "$root/envoy" "$trust" "$trust/sources"
  cat >"/etc/monvm/$service-trust.env" <<ENV
MONVM_BUCKET=${bucket}
MONVM_REGION=${region}
MONVM_S3_ENDPOINT=https://s3.dualstack.${region}.amazonaws.com
MONVM_TRUST_STATE=$trust
ENV
  chmod 0600 "/etc/monvm/$service-trust.env"

  install_oneshot \
    "monvm-$service-network" \
    "Configure the MonVM $service service ENI" \
    "/usr/local/sbin/monvm-configure-service-network $mac $${private_ipv4:--} ${subnet_ipv4_cidr != "" ? subnet_ipv4_cidr : "-"} ${subnet_ipv4_gateway != "" ? subnet_ipv4_gateway : "-"} $ipv6 ${subnet_ipv6_cidr} $table" \
    network-online.target envoy.service '' true

  if [[ ! -s "$root/envoy/server-ca.key" || ! -s "$root/envoy/server-ca.crt" ]]; then
    if [[ -s "$root/envoy/server.key" && -s "$root/envoy/server.crt" ]]; then
      mv "$root/envoy/server.key" "$root/envoy/server-ca.key"
      mv "$root/envoy/server.crt" "$root/envoy/server-ca.crt"
    else
      openssl req -x509 -newkey ed25519 -nodes -days 3650 \
        -subj "/CN=MonVM $display server CA" \
        -addext 'basicConstraints=critical,CA:TRUE' \
        -addext 'keyUsage=critical,keyCertSign,cRLSign' \
        -keyout "$root/envoy/server-ca.key" \
        -out "$root/envoy/server-ca.crt"
    fi
  fi
  chmod 0600 "$root/envoy/server-ca.key"
  chmod 0644 "$root/envoy/server-ca.crt"

  local certificate_valid=false san="IP:$ipv6"
  if [[ -s "$root/envoy/server.key" && -s "$root/envoy/server.crt" ]] && \
    openssl x509 -in "$root/envoy/server.crt" -noout -checkip "$ipv6" >/dev/null 2>&1; then
    certificate_valid=true
  fi
  if [[ -n "$public_ipv4" ]]; then
    san+=",IP:$public_ipv4"
    if ! openssl x509 -in "$root/envoy/server.crt" -noout -checkip "$public_ipv4" >/dev/null 2>&1; then
      certificate_valid=false
    fi
  fi
  if [[ "$certificate_valid" != true ]]; then
    openssl req -new -newkey ed25519 -nodes \
      -subj "/CN=MonVM $display" \
      -addext 'basicConstraints=critical,CA:FALSE' \
      -addext 'keyUsage=critical,digitalSignature' \
      -addext 'extendedKeyUsage=serverAuth' \
      -addext "subjectAltName=$san" \
      -keyout "$root/envoy/server.key" \
      -out "$root/envoy/server.csr"
    openssl x509 -req -days 3650 \
      -in "$root/envoy/server.csr" \
      -CA "$root/envoy/server-ca.crt" \
      -CAkey "$root/envoy/server-ca.key" \
      -CAcreateserial \
      -copy_extensions copy \
      -out "$root/envoy/server.crt"
    rm -f "$root/envoy/server.csr"
  fi
  chown envoy:envoy "$root/envoy/server.key" "$root/envoy/server.crt"
  chmod 0600 "$root/envoy/server.key"
  chmod 0644 "$root/envoy/server.crt"

  if [[ ! -s "$trust/deny-all.pem" ]]; then
    openssl req -x509 -newkey ed25519 -nodes -days 3650 \
      -subj "/CN=MonVM $service empty trust set" \
      -addext 'basicConstraints=critical,CA:TRUE' \
      -addext 'keyUsage=critical,keyCertSign,cRLSign' \
      -keyout "/tmp/monvm-$service-deny-all.key" \
      -out "$trust/deny-all.pem"
    rm -f "/tmp/monvm-$service-deny-all.key"
  fi
  chmod 0644 "$trust/deny-all.pem"

  aws s3 cp "$root/envoy/server-ca.crt" "s3://${bucket}/tls/$service-server-ca.pem" \
    --region "${region}" --endpoint-url "https://s3.dualstack.${region}.amazonaws.com"

  cat >"/etc/envoy/$service-client-validation.yaml" <<YAML
resources:
  - "@type": type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.Secret
    name: $service-client-validation
    validation_context:
      trusted_ca:
        filename: $trust/bundle.pem
        watched_directory:
          path: $trust
YAML

  install_oneshot \
    "monvm-$service-trust-enroll" \
    "Enroll MonVM $service client certificate authorities from S3" \
    "/usr/bin/env MONVM_TRUST_ENV=/etc/monvm/$service-trust.env /usr/local/sbin/monvm-trust-enroll" \
    network-online.target envoy.service '' true
  install_oneshot \
    "monvm-$service-trust-refresh" \
    "Refresh MonVM $service client certificate authorities from S3" \
    "/usr/bin/env MONVM_TRUST_ENV=/etc/monvm/$service-trust.env /usr/local/sbin/monvm-trust-refresh" \
    "network-online.target monvm-$service-trust-enroll.service" '' "monvm-$service-trust-enroll.service" false
  install_timer \
    "monvm-$service-trust-refresh" \
    "Refresh MonVM $service client certificate authorities every 10 minutes" \
    10min
}

write_envoy_listener() {
  local service=$1 port=$2 root=$3
  cat >>/etc/envoy/envoy.yaml <<YAML
    - name: $service-mtls
      address:
        socket_address:
          address: "::"
          port_value: $port
          ipv4_compat: true
      filter_chains:
        - filters:
            - name: envoy.filters.network.http_connection_manager
              typed_config:
                "@type": type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
                stat_prefix: $service-ingress
                codec_type: AUTO
                route_config:
                  name: victoria-$service
                  virtual_hosts:
                    - name: victoria-$service
                      domains: ["*"]
                      routes:
                        - match: { prefix: "/" }
                          route: { cluster: victoria-$service }
                http_filters:
                  - name: envoy.filters.http.router
                    typed_config:
                      "@type": type.googleapis.com/envoy.extensions.filters.http.router.v3.Router
          transport_socket:
            name: envoy.transport_sockets.tls
            typed_config:
              "@type": type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.DownstreamTlsContext
              require_client_certificate: true
              common_tls_context:
                tls_params:
                  tls_minimum_protocol_version: TLSv1_3
                  signature_algorithms:
                    - ed25519
                    - ecdsa_secp256r1_sha256
                    - rsa_pss_rsae_sha256
                    - rsa_pkcs1_sha256
                    - ecdsa_secp384r1_sha384
                    - rsa_pss_rsae_sha384
                    - rsa_pkcs1_sha384
                    - rsa_pss_rsae_sha512
                    - rsa_pkcs1_sha512
                alpn_protocols: ["h2", "http/1.1"]
                tls_certificates:
                  - certificate_chain: { filename: "$root/envoy/server.crt" }
                    private_key: { filename: "$root/envoy/server.key" }
                validation_context_sds_secret_config:
                  name: $service-client-validation
                  sds_config:
                    path_config_source:
                      path: /etc/envoy/$service-client-validation.yaml
YAML
}

write_envoy_cluster() {
  local service=$1 port=$2
  cat >>/etc/envoy/envoy.yaml <<YAML
    - name: victoria-$service
      type: STATIC
      connect_timeout: 5s
      load_assignment:
        cluster_name: victoria-$service
        endpoints:
          - lb_endpoints:
              - endpoint:
                  address:
                    socket_address:
                      address: 127.0.0.1
                      port_value: $port
YAML
}
%{ endif ~}

%{ if metrics_enabled ~}
useradd --system --home-dir /var/lib/victoria-metrics --shell /usr/sbin/nologin victoria-metrics || true
mount_volume "${metrics_volume_id}" /var/lib/victoria-metrics "${metrics_volume_size}"
chown victoria-metrics:victoria-metrics /var/lib/victoria-metrics
install_archive "${metrics_object_key}" "${metrics_sha256}" "${metrics_binary}" /usr/local/bin/victoria-metrics
install_daemon \
  victoria-metrics \
  'VictoriaMetrics single-node database' \
  victoria-metrics \
  '/usr/local/bin/victoria-metrics -httpListenAddr=127.0.0.1:18428 -storageDataPath=/var/lib/victoria-metrics -retentionPeriod=${metrics_retention}' \
  network-online.target '' /var/lib/victoria-metrics SIGINT
configure_service metrics VictoriaMetrics "${metrics_ipv6}" "${metrics_ipv4}" "${metrics_private_ipv4}" "${metrics_mac}" 100 /var/lib/victoria-metrics
%{ endif ~}

%{ if logs_enabled ~}
useradd --system --home-dir /var/lib/victoria-logs --shell /usr/sbin/nologin victoria-logs || true
mount_volume "${logs_volume_id}" /var/lib/victoria-logs "${logs_volume_size}"
chown victoria-logs:victoria-logs /var/lib/victoria-logs
install_archive "${logs_object_key}" "${logs_sha256}" "${logs_binary}" /usr/local/bin/victoria-logs
install_daemon \
  victoria-logs \
  'VictoriaLogs single-node database' \
  victoria-logs \
  '/usr/local/bin/victoria-logs -httpListenAddr=127.0.0.1:19428 -storageDataPath=/var/lib/victoria-logs -retentionPeriod=${logs_retention} -retention.maxDiskUsagePercent=80' \
  network-online.target '' /var/lib/victoria-logs SIGINT
configure_service logs VictoriaLogs "${logs_ipv6}" "${logs_ipv4}" "${logs_private_ipv4}" "${logs_mac}" 101 /var/lib/victoria-logs
%{ endif ~}

cat >/etc/envoy/envoy.yaml <<'YAML'
node:
  id: monvm
  cluster: monvm

admin:
  address:
    socket_address:
      address: 127.0.0.1
      port_value: 9900

static_resources:
  listeners:
YAML
%{ if metrics_enabled ~}write_envoy_listener metrics 8428 /var/lib/victoria-metrics
%{ endif ~}%{ if logs_enabled ~}write_envoy_listener logs 9428 /var/lib/victoria-logs
%{ endif ~}printf '  clusters:\n' >>/etc/envoy/envoy.yaml
%{ if metrics_enabled ~}write_envoy_cluster metrics 18428
%{ endif ~}%{ if logs_enabled ~}write_envoy_cluster logs 19428
%{ endif ~}

envoy_dependencies=(
%{ if metrics_enabled ~}  monvm-metrics-network.service victoria-metrics.service monvm-metrics-trust-enroll.service
%{ endif ~}%{ if logs_enabled ~}  monvm-logs-network.service victoria-logs.service monvm-logs-trust-enroll.service
%{ endif ~})
dependencies="$${envoy_dependencies[*]}"
install_daemon envoy 'Envoy mTLS proxy' envoy \
  '/usr/local/bin/envoy -c /etc/envoy/envoy.yaml --log-level info' \
  "network-online.target $dependencies" "$dependencies" '' ''

systemctl daemon-reload
systemctl enable envoy
%{ if metrics_enabled ~}systemctl enable victoria-metrics monvm-metrics-network monvm-metrics-trust-enroll
systemctl enable --now monvm-metrics-trust-refresh.timer
systemctl start victoria-metrics
systemctl start monvm-metrics-trust-enroll
%{ endif ~}%{ if logs_enabled ~}systemctl enable victoria-logs monvm-logs-network monvm-logs-trust-enroll
systemctl enable --now monvm-logs-trust-refresh.timer
systemctl start victoria-logs
systemctl start monvm-logs-trust-enroll
%{ endif ~}systemctl start envoy
